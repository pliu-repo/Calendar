<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/weekly_event_item_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/medium_margin"
    android:background="@drawable/section_holder_stroke"
    android:foreground="@drawable/selector_rounded">

    <ImageView
        android:id="@+id/weekly_event_item_color_bar"
        android:layout_width="@dimen/event_color_bar_width"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/small_margin"
        android:background="@drawable/event_list_color_bar"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/weekly_event_item_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/weekly_event_item_title" />

    <!-- Important icon (visible only when isImportant == true in Taskify mode) -->
    <ImageView
        android:id="@+id/weekly_event_item_important_image"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/tiny_margin"
        android:contentDescription="@string/important"
        android:paddingTop="@dimen/small_margin"
        android:paddingBottom="@dimen/small_margin"
        android:src="@drawable/ic_important_vector"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/weekly_event_item_title"
        app:layout_constraintStart_toEndOf="@+id/weekly_event_item_color_bar"
        app:layout_constraintTop_toTopOf="@+id/weekly_event_item_title" />

    <TextView
        android:id="@+id/weekly_event_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="false"
        android:ellipsize="none"
        android:maxLines="3"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/tiny_margin"
        android:paddingTop="@dimen/small_margin"
        android:paddingEnd="@dimen/tiny_margin"
        android:paddingBottom="@dimen/tiny_margin"
        android:textSize="@dimen/day_text_size"
        app:layout_constraintEnd_toStartOf="@+id/weekly_event_item_checkbox"
        app:layout_constraintStart_toEndOf="@+id/weekly_event_item_important_image"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Event title" />

    <!-- Red strikethrough overlay for completed Taskify events -->
    <View
        android:id="@+id/weekly_event_item_completed_line"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/taskify_strikethrough"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/weekly_event_item_title"
        app:layout_constraintEnd_toStartOf="@+id/weekly_event_item_checkbox"
        app:layout_constraintStart_toStartOf="@+id/weekly_event_item_title"
        app:layout_constraintTop_toTopOf="@+id/weekly_event_item_title" />

    <!-- Taskify completion checkbox (shown for Taskify events, hidden otherwise) -->
    <ImageView
        android:id="@+id/weekly_event_item_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/small_margin"
        android:contentDescription="@string/toggle_completion"
        android:paddingTop="@dimen/small_margin"
        android:paddingBottom="@dimen/small_margin"
        android:src="@drawable/ic_checkbox_unchecked_vector"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/weekly_event_item_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/weekly_event_item_title" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/weekly_event_item_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:alpha="0.8"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/small_margin"
        android:paddingEnd="@dimen/small_margin"
        android:paddingBottom="@dimen/small_margin"
        android:textFontWeight="300"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/weekly_event_item_color_bar"
        app:layout_constraintTop_toBottomOf="@+id/weekly_event_item_title"
        tools:text="13:00" />

</androidx.constraintlayout.widget.ConstraintLayout>
